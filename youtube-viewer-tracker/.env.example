# ─ YouTube API ───────────────────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com → Enable "YouTube Data API v3" → Credentials → API Key
YOUTUBE_API_KEY=YOUR_API_KEY_HERE

# Channel handle (without @) — the app resolves this to a channel ID automatically
YOUTUBE_CHANNEL_HANDLE=yogacirclebycult

# OR paste the channel ID directly if you have it (skips API resolution call)
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxx

# ─ Supabase ───────────────────────────────────────────────────────────────────────────
# Supabase project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─ Cron security ───────────────────────────────────────────────────────────────────────
# Any random string — Vercel sends this as Bearer token to authenticate cron calls
# Generate one: openssl rand -hex 32
CRON_SECRET=your-random-secret-here
